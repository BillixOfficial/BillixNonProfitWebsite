# Copy to .env for local development. Never commit real secrets.

# development | test | staging | production
ENVIRONMENT=development

# PostgreSQL via psycopg 3. Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/billix_dev

# Public website origin used to build email links (no trailing slash).
SITE_URL=http://localhost:3000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# console (logs emails to stdout) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=The Billix Brief <brief@example.com>

# Where contact-form notifications are delivered (optional; skipped if empty).
CONTACT_INBOX=

# Secrets: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Required (non-default) when ENVIRONMENT=production; the app refuses to start otherwise.
IP_HASH_SALT=change-me
TOKEN_SECRET=change-me

# Optional
# DOCS_ENABLED=true            # force /docs on in production
# LOG_LEVEL=INFO
# RATE_LIMIT_WRITES=5          # form submissions per IP per window
# RATE_LIMIT_TOKENS=20         # confirm/unsubscribe/preferences calls per IP per window
# RATE_LIMIT_WINDOW_SECONDS=60
# TRUST_PROXY_HEADERS=false    # true only behind a proxy that sets X-Forwarded-For
# NEWSLETTER_CONSENT_VERSION=2026-10-v1
# CONFIRM_TOKEN_TTL_HOURS=48
